<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.brekquater</groupId>
  <artifactId>brekquater-spring-boot-template</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Brekquater Spring Boot Template</name>
  <description>A ready-to-use Spring Boot 4 REST API with Swagger UI and built-in API design feedback.</description>

  <properties>
    <java.version>17</java.version>
    <brekquater-api-starter.version>0.1.0</brekquater-api-starter.version>
    <jacoco.version>0.8.16</jacoco.version>
    <!--
      Spring Boot 4.1.2 manages Jackson 3.1.7 and 2.21.7, which have CVE-2026-110879 (CVSS 9.8). These versions fix it.
      Delete both lines once the Spring Boot version above manages Jackson 3.1.8 and 2.21.8 or newer.
    -->
    <jackson-bom.version>3.3.0</jackson-bom.version>
    <jackson-2-bom.version>2.23.0</jackson-2-bom.version>
  </properties>

  <dependencies>
    <!-- Brings Spring MVC, springdoc-openapi with Swagger UI, and the API maturity panel. -->
    <dependency>
      <groupId>com.brekquater</groupId>
      <artifactId>brekquater-api-spring-boot-starter</artifactId>
      <version>${brekquater-api-starter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Writes target/site/jacoco/jacoco.xml, which the starter reads to check coverage in the API maturity panel. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
